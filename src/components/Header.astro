---
export interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Collection", href: "/collection" },
  { label: "Atelier", href: "/atelier" },
  { label: "Our Story", href: "/our-story" },
  { label: "Shop All", href: "/shop" },
];
---

<header
  class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md shadow-sm"
>
  <div
    class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto"
  >
    <a
      href="/"
      class="font-display-lg text-display-lg text-primary tracking-tight no-underline"
    >
      Safa Craft
    </a>
    <nav class="hidden md:flex gap-gutter items-center">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`
            font-body-md text-body-md no-underline transition-colors duration-300
            ${
              currentPage === item.href
                ? "text-primary font-bold border-b-2 border-primary"
                : "text-on-surface-variant hover:text-primary"
            }
          `}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div
      class="flex items-center gap-stack-sm text-primary"
    >
      <button
        aria-label="Shopping Bag"
        class="hover:opacity-80 transition-all p-2 rounded-full cursor-pointer"
      >
        <span class="material-symbols-outlined">shopping_bag</span>
      </button>
      <button
        aria-label="Account"
        class="hover:opacity-80 transition-all p-2 rounded-full cursor-pointer"
      >
        <span class="material-symbols-outlined">person</span>
      </button>
      <button
        id="menu-btn"
        aria-label="Menu"
        class="md:hidden hover:opacity-80 transition-all p-2 rounded-full cursor-pointer"
      >
        <span id="menu-icon" class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="md:hidden fixed inset-x-0 top-[72px] bottom-0 bg-surface/95 backdrop-blur-md translate-x-full transition-transform duration-300 z-40"
  >
    <div class="flex flex-col gap-2 p-margin-mobile pt-4 bg-white">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`
            font-body-lg text-body-lg no-underline px-4 py-3 rounded-lg transition-colors duration-200
            ${
              currentPage === item.href
                ? "text-primary font-bold bg-primary-container/20"
                : "text-on-surface-variant hover:text-primary hover:bg-surface-container-high"
            }
          `}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");

  if (menuBtn && mobileMenu && menuIcon) {
    menuBtn.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.toggle("translate-x-full");
      menuIcon.textContent = isOpen ? "menu" : "close";
    });
  }
</script>
