---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Atelier - Safa Craft">
  <Header currentPage="/atelier" />
  <main class="flex-grow">
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg md:py-24">
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-stack-sm">
          Our Atelier
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Step into our creative workspace where every piece begins with a single stitch.
          Our atelier is where tradition meets contemporary design.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
