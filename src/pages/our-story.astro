---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Our Story - Safa Craft">
  <Header currentPage="/our-story" />
  <main class="flex-grow">
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg md:py-24">
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-stack-sm">
          Our Story
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Safa Craft was born from a love for the tactile and the timeless. We are a
          collective of artisans dedicated to preserving the art of hand-crochet.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
